# Optional askLabTutor callable configuration; the chat UI uses Firebase AI Logic.
# Copy to functions/.env and set model names verified for your provider account.
# GEMINI_MODEL=your_gemini_model
# OPENAI_MODEL=your_openai_model
# Store GEMINI_API_KEY and OPENAI_API_KEY in server secrets, never VITE_* variables.
# Provider selection is supplied in the callable request, not an AI_PROVIDER variable.
