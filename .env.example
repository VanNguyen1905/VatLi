# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values
# NEVER commit .env.local to version control

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Public reCAPTCHA Enterprise site key used by Firebase AI Logic.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Existing Owner account email used by the admin login mapping.
VITE_ADMIN_LOGIN_EMAIL=

# Optional: Firebase Emulator
VITE_USE_FIREBASE_EMULATOR=false

# Enable only after reviewing/deploying the matching progress rules with approval.
# Local Emulator mode enables progress sync automatically. Default production is local-only.
VITE_LAB_PROGRESS_SYNC=false
